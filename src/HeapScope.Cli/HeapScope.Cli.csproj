<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>heapscope-cli</AssemblyName>
    <RootNamespace>HeapScope.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeapScope.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeapScope.Application\HeapScope.Application.csproj" />
    <ProjectReference Include="..\HeapScope.Contracts\HeapScope.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <Import Project="$(HeapScopeRoot)build\Worker.Deploy.targets" />
  <Import Project="$(HeapScopeRoot)build\Sample.Deploy.targets" />

  <!--
    The CLI as a dotnet tool (sprint 3.9, ADR-039): one framework-dependent package for every system, built by
    build/pack-tool.sh, which collects the license files into HeapScopeToolLicenses first, and the package's own license
    file (the AGPL with its additional terms and the commercial terms) into HeapScopePackageFiles. The worker ships as its
    assembly without an executable (a tool's files must run anywhere), and the front end starts it through the dotnet host.
  -->
  <PropertyGroup Condition="'$(HeapScopeTool)' == 'true'">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>heapscope-cli</ToolCommandName>
    <PackageId>HeapScope.Cli</PackageId>
    <Authors>Ray Klundt</Authors>
    <Description>HeapScope's command line: capture (Windows and Linux; macOS untested) and analyze .NET memory dumps and gcdumps, from heap summaries to retention paths and leak detectors.</Description>
    <PackageTags>dotnet;memory;heap;dump;gcdump;leak;diagnostics</PackageTags>
    <PackageProjectUrl>https://github.com/klundt-org/HeapScope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/klundt-org/HeapScope</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The notes nuget.org shows for this version; a release checks they start with its version (release.yml). -->
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)package-release-notes.txt'))</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup Condition="'$(HeapScopeTool)' == 'true'">
    <None Include="$(HeapScopePackageFiles)/LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <!-- The license files go next to the CLI in the tool's folder, as in a published build. -->
  <Target Name="HeapScopeToolLicenses" AfterTargets="Publish" Condition="'$(HeapScopeTool)' == 'true'">
    <Error Condition="!Exists('$(HeapScopeToolLicenses)/licenses/README.md')" Text="HeapScopeToolLicenses must name the folder build/collect-licenses.cs wrote; run build/pack-tool.sh." />
    <ItemGroup>
      <_HeapScopeToolLicenseFiles Include="$(HeapScopeToolLicenses)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HeapScopeToolLicenseFiles)" DestinationFiles="@(_HeapScopeToolLicenseFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
