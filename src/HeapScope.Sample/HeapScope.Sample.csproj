<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tutorial's sample process (ADR-042), shipped in sample/ beside worker/. -->
    <AssemblyName>heapscope-sample</AssemblyName>
    <RootNamespace>HeapScope.Sample</RootNamespace>
    <!-- It plants problems on purpose and stands in for an application, so it is always optimized (fixtures/Directory.Build.props). -->
    <Optimize>true</Optimize>
    <!-- The runtime identifiers it is published for, as the app states them, so a restore for one leaves the lock file as it is. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeapScope.Sample.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fixtures' planted problems, shared so one known answer serves the fixture tests and the lessons. -->
    <ProjectReference Include="..\..\fixtures\Leaks\Leaks.csproj" />
  </ItemGroup>
</Project>
