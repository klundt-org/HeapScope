<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
  <StackPanel Margin="4">
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
      <TextBlock Classes="pageTitle" Text="Settings" VerticalAlignment="Center" />
      <ctl:InfoIcon Text="{x:Static vm:InfoTexts.Settings}" />
    </StackPanel>
    <!-- Sprint 3.12, B1: the Logging section; the texts are the owner's (docs/design/info-text.md, Sprint 3.12 additions). -->
    <TextBlock Text="Logging" FontWeight="SemiBold" Margin="0,0,0,6" />
    <CheckBox Content="Include filter text in logs" IsChecked="{Binding IncludeFilterTextInLogs}"
              ToolTip.Tip="Write the text you type in filters and searches into HeapScope's logs, to help troubleshoot a result. It can hold values from your dumps (account numbers, tokens), so turn it off before you share a log." />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Purge logs" Command="{Binding PurgeLogsCommand}"
              ToolTip.Tip="Delete HeapScope's log files. Logs that running HeapScope processes write now are kept until they close." />
      <Button Content="Purge all" Command="{Binding PurgeAllCommand}"
              ToolTip.Tip="Delete HeapScope's logs and everything in its library: sessions, captures, dumps, traces, timelines, saved indexes and bookmarks. Dumps you opened from your own folders are not touched." />
    </StackPanel>
    <SelectableTextBlock Margin="0,8,0,0" Text="{Binding LogFolder, StringFormat='Logs: {0}'}" TextWrapping="Wrap" Classes="subtle" />
    <SelectableTextBlock Margin="0,8,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
