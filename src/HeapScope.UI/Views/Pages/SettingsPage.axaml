<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
  <StackPanel Margin="4">
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
      <TextBlock Classes="pageTitle" Text="Settings" VerticalAlignment="Center" />
      <ctl:InfoIcon Text="{x:Static vm:InfoTexts.Settings}" />
    </StackPanel>
    <!-- The Dumps section, where a missing DAC is found; drafts (docs/design/info-text.md). -->
    <TextBlock Text="Dumps" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock Text="DAC folder" Margin="0,0,0,4" />
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBox x:Name="DacFolderBox" Text="{Binding DacFolder}" PlaceholderText="None: the .NET runtimes installed here only"
               ToolTip.Tip="{x:Static vm:InfoTexts.DacFolderTip}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveDacFolderCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..." Command="{Binding PickDacFolderCommand}"
              ToolTip.Tip="Choose the folder that holds the DAC, and save it." />
      <Button Grid.Column="2" Margin="8,0,0,0" Content="Save" Command="{Binding SaveDacFolderCommand}"
              ToolTip.Tip="Save the folder as typed. An empty box clears it." />
    </Grid>
    <CheckBox Margin="0,6,0,0" Content="Download missing DACs from Microsoft" IsChecked="{Binding AllowMicrosoftSymbolServer}"
              ToolTip.Tip="{x:Static vm:InfoTexts.SymbolServerTip}" />
    <SelectableTextBlock Margin="0,4,0,0" Text="{Binding DacConfiguredNote}" TextWrapping="Wrap" Classes="subtle"
                         IsVisible="{Binding DacConfiguredNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <!-- The Logging section; the texts are the owner's (docs/design/info-text.md). -->
    <TextBlock Text="Logging" FontWeight="SemiBold" Margin="0,16,0,6" />
    <CheckBox Content="Include filter text in logs" IsChecked="{Binding IncludeFilterTextInLogs}"
              ToolTip.Tip="Write the text you type in filters and searches into HeapScope's logs, to help troubleshoot a result. It can hold values from your dumps (account numbers, tokens), so turn it off before you share a log." />
    <!-- Off by default (owner, 2026-11-19); turning it on asks first (SettingsViewModel). -->
    <CheckBox Content="Include dump values in logs" IsChecked="{Binding IncludeDumpValuesInLogs}"
              ToolTip.Tip="{x:Static vm:InfoTexts.DumpValuesTip}" />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Purge logs" Command="{Binding PurgeLogsCommand}"
              ToolTip.Tip="Delete HeapScope's log files. Logs that running HeapScope processes write now are kept until they close." />
      <Button Content="Purge all" Command="{Binding PurgeAllCommand}"
              ToolTip.Tip="Delete HeapScope's logs and everything in its library: sessions, captures, dumps, traces, timelines, saved indexes and bookmarks. Dumps you opened from your own folders are not touched." />
    </StackPanel>
    <SelectableTextBlock Margin="0,8,0,0" Text="{Binding LogFolder, StringFormat='Logs: {0}'}" TextWrapping="Wrap" Classes="subtle" />
    <SelectableTextBlock Margin="0,8,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
