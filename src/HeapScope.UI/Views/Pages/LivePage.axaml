<!-- The Live page (sprint 1.7): a process's GC heap every interval, and rules that take snapshots into the current session. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             x:Class="HeapScope.UI.Views.Pages.LivePage"
             x:DataType="vm:LiveViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="pageTitle" Text="Live" VerticalAlignment="Center" />
        <ctl:InfoIcon Text="{x:Static vm:InfoTexts.Live}" />
      </StackPanel>
      <TextBlock Text="Watch a process's GC heap every interval, and take dumps into the current session when a rule fires." Classes="subtle" Margin="0,0,0,8" />
      <Border Classes="info" IsVisible="{Binding Unavailable, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Unavailable}" />
      </Border>
      <Border Classes="info" Margin="0,0,0,6" IsVisible="{Binding HiddenNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock TextWrapping="Wrap" Text="{Binding HiddenNote}" />
      </Border>
      <WrapPanel Margin="0,0,0,6">
        <TextBlock Text="Process" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Width="320" PlaceholderText="Choose a process" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProcessRow">
              <TextBlock><Run Text="{Binding Name}" /><Run Text=" (pid " /><Run Text="{Binding ProcessId}" /><Run Text=")" /><Run Text="{Binding ElevationSuffix}" /></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button ctl:ButtonIcon.Icon="Refresh" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        <!-- Sprint 4.1.1: the processes HeapScope cannot watch as it runs now are hidden unless this is checked. -->
        <CheckBox Content="{x:Static vm:PlatformHints.ShowHidden}" Margin="12,0,0,0" VerticalAlignment="Center"
                  IsChecked="{Binding ShowHiddenProcesses}" IsVisible="{Binding CanShowHiddenProcesses}"
                  ToolTip.Tip="{x:Static vm:PlatformHints.ShowHiddenTip}" />
        <TextBlock Text="Sample every (s)" VerticalAlignment="Center" Margin="16,0,6,0" />
        <TextBox Width="50" Text="{Binding IntervalSeconds, Mode=TwoWay}" VerticalAlignment="Center"
                 ToolTip.Tip="How often HeapScope reads the process's heap counters, in whole seconds, at least 1, and the chart keeps the last 1,800 samples. It applies at the next Start, and rules are checked at each sample." />
        <Button ctl:ButtonIcon.Icon="Start" Classes="primary" Content="Start" Margin="16,0,0,0" Command="{Binding StartCommand}" VerticalAlignment="Center" />
        <Button ctl:ButtonIcon.Icon="Stop" Content="Stop" Margin="8,0,0,0" Command="{Binding StopCommand}" VerticalAlignment="Center" />
        <Button x:Name="GetSnapshotButton" Content="Get snapshot" Margin="16,0,0,0" Command="{Binding GetSnapshotCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Captures the monitored process now, as set by &quot;as gcdumps&quot;, and does not count toward &quot;at most&quot;. Needs a run going, with no snapshot or Force GC of it in progress." />
        <Button x:Name="ForceGcButton" Content="Force GC" Margin="8,0,0,0" Command="{Binding ForceGcCommand}" VerticalAlignment="Center"
                ToolTip.Tip="After asking, runs a full blocking garbage collection in the process (a dotted line); objects it moves count as dead and new when compared by address. Needs a run going, with no snapshot or Force GC of it in progress." />
      </WrapPanel>
      <Expander x:Name="RulesExpander" Margin="0,0,0,6" HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Snapshot rules" VerticalAlignment="Center" />
            <ctl:InfoIcon Text="{x:Static vm:InfoTexts.LiveRules}" />
          </StackPanel>
        </Expander.Header>
        <WrapPanel>
          <TextBlock Text="Snapshot every (min)" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Width="60" Text="{Binding Every, Mode=TwoWay}" VerticalAlignment="Center" />
          <TextBlock Text="when above" VerticalAlignment="Center" Margin="12,0,6,0" />
          <TextBox Width="80" Text="{Binding Above, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="A size such as 500MB or 2GB." />
          <TextBlock Text="or grown by" VerticalAlignment="Center" Margin="12,0,6,0" />
          <TextBox Width="80" Text="{Binding Growth, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="Over the first sample: a size such as 100MB or a percent such as 50%." />
          <TextBlock Text="then" VerticalAlignment="Center" Margin="12,0,6,0" />
          <ComboBox Width="90" ItemsSource="{Binding RearmModes}" SelectedItem="{Binding Rearm, Mode=TwoWay}" VerticalAlignment="Center" />
          <TextBlock Text="at most" VerticalAlignment="Center" Margin="12,0,6,0" />
          <TextBox Width="50" Text="{Binding MaxSnapshots, Mode=TwoWay}" VerticalAlignment="Center" />
          <CheckBox Content="as gcdumps" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding CaptureGcDumps, Mode=TwoWay}" />
          <CheckBox Content="Record allocations" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding RecordAllocations, Mode=TwoWay}" />
        </WrapPanel>
      </Expander>
      <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Past runs of this session" VerticalAlignment="Center" />
            <ctl:InfoIcon Text="{x:Static vm:InfoTexts.LivePastRuns}" />
          </StackPanel>
        </Expander.Header>
        <WrapPanel>
                  <ComboBox x:Name="PastRuns" Width="420" ItemsSource="{Binding PastRuns.Runs}" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PastRunItem">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Show" Margin="6,0,0,0" Command="{Binding PastRuns.OpenPastRunCommand}" CommandParameter="{Binding #PastRuns.SelectedItem}" VerticalAlignment="Center" />
          <Button ctl:ButtonIcon.Icon="Refresh" Content="Refresh" Margin="6,0,0,0" Command="{Binding PastRuns.RefreshRunsCommand}" VerticalAlignment="Center" />
          <Button Content="Open allocations" Margin="16,0,0,0" Command="{Binding Files.OpenTraceCommand}" VerticalAlignment="Center" />
        </WrapPanel>
      </Expander>
      <Border Classes="info" IsVisible="{Binding Shown.RunWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <SelectableTextBlock x:Name="RunWarningText" TextWrapping="Wrap" Text="{Binding Shown.RunWarning}" />
      </Border>
      <ctl:NoteText Text="{Binding Shown.PastRunShown}" TextWrapping="Wrap" Margin="0,0,0,4" Classes="subtle" />
      <ctl:NoteText Text="{Binding Shown.Status}" TextWrapping="Wrap" Margin="0,0,0,4" />
      <WrapPanel Margin="0,0,0,6" IsVisible="{Binding Files.HasTimeline}">
        <TextBlock Text="Timeline:" VerticalAlignment="Center" Margin="0,0,6,0"
                   ToolTip.Tip="One row per sample (heap sizes, GC counts, time in GC) and one per snapshot, as CSV. Counters only, none of the process's data." />
        <SelectableTextBlock Text="{Binding Files.TimelinePath}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Content="Open" Command="{Binding Files.OpenTimelineCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                ToolTip.Tip="Open the timeline in the app for CSV files, such as a spreadsheet." />
        <Button ctl:ButtonIcon.Icon="OpenFile" Content="Show in folder" Command="{Binding Files.ShowTimelineCommand}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Button ctl:ButtonIcon.Icon="Delete" Content="Delete..." Command="{Binding Files.DeleteTimelineCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Deletes the timeline file after asking, and the run's snapshots are kept. That run can no longer be shown under Past runs." />
      </WrapPanel>
      <DockPanel Margin="0,0,0,6">
        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Growth}" CornerRadius="3" Padding="8,1"
                IsVisible="{Binding HighGcPressure}"
                ToolTip.Tip="The process spent 10 percent or more of its time in garbage collection, averaged over the last ten samples that had a collection.">
          <TextBlock Text="High GC pressure" Foreground="{DynamicResource Brush.Window}" FontWeight="SemiBold" />
        </Border>
        <TextBlock Text="{Binding Latest}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Latest}" Classes="subtle" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen0}" Margin="0,0,4,0" /><TextBlock Text="Gen0" Margin="0,0,10,0" FontSize="11" />
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen1}" Margin="0,0,4,0" /><TextBlock Text="Gen1" Margin="0,0,10,0" FontSize="11" />
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen2}" Margin="0,0,4,0" /><TextBlock Text="Gen2" Margin="0,0,10,0" FontSize="11" />
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.LargeObjectHeap}" Margin="0,0,4,0" /><TextBlock Text="LOH" Margin="0,0,10,0" FontSize="11" />
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.PinnedObjectHeap}" Margin="0,0,4,0" /><TextBlock Text="POH" Margin="0,0,10,0" FontSize="11" />
        <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Unknown}" Margin="0,0,4,0" /><TextBlock Text="allocated since the last GC" Margin="0,0,10,0" FontSize="11" />
        <TextBlock Text="(generations as of the last GC; dashed line: snapshot; dotted line: forced GC)" FontSize="11" Classes="subtle" VerticalAlignment="Center" />
        <ctl:InfoIcon Text="{x:Static vm:InfoTexts.LiveChart}" Margin="6,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer DockPanel.Dock="Right" Width="300" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding Shown.Snapshots.Count, Converter={x:Static ctl:SignConverters.HasItems}}">
      <ItemsControl ItemsSource="{Binding Shown.Snapshots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SnapshotCard">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock><Run Text="{Binding Time}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Rule}" /></TextBlock>
                <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" Classes="subtle" />
                <Button ctl:ButtonIcon.Icon="OpenFile" Classes="compact" Content="Show in folder" Margin="0,4,0,0" HorizontalAlignment="Left"
                        IsVisible="{Binding Path, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding $parent[ItemsControl].((vm:LiveViewModel)DataContext).Files.ShowSnapshotCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <!-- Sprint 4.3: what the process allocates while the run records it, below the chart. -->
    <Border x:Name="LiveAllocationsPanel" DockPanel.Dock="Bottom" Height="300" Margin="0,6,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8,4"
            IsVisible="{Binding Allocations.IsShown}">
      <DockPanel DataContext="{Binding Allocations}" x:DataType="vm:LiveAllocationsViewModel">
        <WrapPanel DockPanel.Dock="Top">
          <TextBlock Text="Allocations" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ctl:InfoIcon Text="{x:Static vm:InfoTexts.LiveAllocations}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock x:Name="LiveDelay" Text="{Binding Delay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"
                     IsVisible="{Binding Delay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Interval}" Classes="subtle" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Button Classes="compact" Content="Whole run" Command="{Binding WholeRunCommand}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <CheckBox Content="Show call stacks" IsChecked="{Binding ShowStacks, Mode=TwoWay}" VerticalAlignment="Center" />
        </WrapPanel>
        <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Note}" TextWrapping="Wrap" Classes="subtle" />
        <ctl:AllocationTimeline DockPanel.Dock="Top" x:Name="LiveAllocationTimeline" Height="56" Margin="0,4"
                                Buckets="{Binding Buckets}" BucketSeconds="{Binding BucketSeconds}" DurationSeconds="{Binding DurationSeconds}"
                                Selection="{Binding Selection, Mode=TwoWay}" />
        <Grid ColumnDefinitions="2*,6,3*">
          <DataGrid x:Name="LiveTypesGrid" ctl:GridExports.ExportName="LiveAllocatedTypes" Grid.Column="0" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" CanUserSortColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" x:DataType="vm:LiveTypeItem" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="Bytes" x:DataType="vm:LiveTypeItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110" CellStyleClasses="number" />
              <DataGridTextColumn Header="%" x:DataType="vm:LiveTypeItem" Binding="{Binding Percent, StringFormat='{}{0:N1}', Mode=OneWay}" Width="60" CellStyleClasses="number" />
              <DataGridTextColumn Header="Samples" x:DataType="vm:LiveTypeItem" Binding="{Binding Samples, StringFormat='{}{0:N0}', Mode=OneWay}" Width="80" CellStyleClasses="number" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" IsVisible="{Binding ShowStacks}" />
          <DockPanel Grid.Column="2" IsVisible="{Binding ShowStacks}">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
              <TextBlock Text="Top call stacks of" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{Binding StacksOf}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
              <Button Classes="compact" Content="All types" Command="{Binding AllTypesCommand}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button Classes="compact" ctl:ButtonIcon.Icon="Refresh" Content="Refresh" Command="{Binding RefreshStacksCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <ctl:NoteText DockPanel.Dock="Top" Text="{Binding StacksStatus}" Classes="subtle" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="3*,6,2*">
              <DataGrid x:Name="LiveStacksGrid" ctl:GridExports.ExportName="LiveAllocationStacks" Grid.Column="0" ItemsSource="{Binding Stacks}" SelectedItem="{Binding SelectedStack, Mode=TwoWay}" CanUserSortColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Bytes" x:DataType="vm:AllocationStackItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}', Mode=OneWay}" Width="100" CellStyleClasses="number" />
                  <DataGridTextColumn Header="%" x:DataType="vm:AllocationStackItem" Binding="{Binding Percent, StringFormat='{}{0:N1}', Mode=OneWay}" Width="60" CellStyleClasses="number" />
                  <DataGridTextColumn Header="Allocated in" x:DataType="vm:AllocationStackItem" Binding="{Binding Top, Mode=OneWay}" Width="*" MinWidth="200" />
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
              <ListBox Grid.Column="2" x:Name="LiveFramesList" ItemsSource="{Binding SelectedFrames}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="MinHeight" Value="22" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
            </Grid>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="4">
      <Grid>
        <ctl:EmptyState Icon="Live" Text="{Binding EmptyText}" IsVisible="{Binding Shown.ShowEmptyState}" />
        <ctl:TimelineChart x:Name="Chart" Samples="{Binding Shown.Samples}" RunStart="{Binding Shown.ChartStart}" Markers="{Binding Shown.Markers}" GcMarkers="{Binding Shown.GcMarkers}" Version="{Binding Shown.ChartVersion}" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
